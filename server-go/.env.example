DEEPSEEK_API_KEY=put-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Цены в USD за 1M токенов (для учёта расходов; сверяйте с тарифом провайдера)
DEEPSEEK_PRICE_INPUT_MISS=0.28
DEEPSEEK_PRICE_INPUT_HIT=0.028
DEEPSEEK_PRICE_OUTPUT=0.42
# Цена распознавания речи, USD за минуту (0 — не учитывать)
TRANSCRIBE_PRICE_PER_MIN=0
# Метка версии тарифа, сохраняется в журнале расходов
PRICE_VERSION=v1
PORT=44096
DATA_DIR=./data
# Отдельный токен для GET /v1/admin/usage (без него endpoint отключён)
ADMIN_TOKEN=
# DeepSeek не предоставляет endpoint распознавания речи.
# При необходимости подключите любой OpenAI-совместимый STT:
#TRANSCRIBE_BASE_URL=https://api.openai.com/v1
#TRANSCRIBE_API_KEY=
#TRANSCRIBE_MODEL=gpt-4o-transcribe
#TRANSCRIBE_LANGUAGE=ru
