<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/currentCar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Автомобиль" android:textSize="24sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/changeCar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Сменить"/>
            <Button android:id="@+id/addCar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+ Добавить"/>
        </LinearLayout>
        <Button android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="История диагностики"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#888888"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Сбор информации" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="OBD-адаптер не подключён — запись возможна с GPS" android:textSize="16sp"/>
        <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Подключить ELM327"/>
        <TextView android:id="@+id/obdValues" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="RPM: —\nSpeed: —\nLoad: —\nThrottle: —\nMAP: —\nCoolant: —\nIntake: —\nVoltage: —" android:textSize="18sp"/>
        <Button android:id="@+id/record" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="НАЧАТЬ ЗАПИСЬ"/>
        <TextView android:id="@+id/recordStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Запись остановлена" android:textSize="16sp"/>
    </LinearLayout>
</ScrollView>
